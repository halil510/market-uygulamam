// lib/ekranlar/borc/borc_odeme_ekrani.dart
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import '../../modeller/borc_model.dart';
import '../../depolar/borc_deposu.dart';
import '../../servisler/bildirim_servisi.dart';
import '../../cekirdek/utils/para_utils.dart';
import '../../uygulama/tema/uygulama_temasi.dart';

class BorcOdemeEkrani extends ConsumerStatefulWidget {
  final BorcModel borc;
  const BorcOdemeEkrani({super.key, required this.borc});

  @override
  ConsumerState<BorcOdemeEkrani> createState() => _BorcOdemeEkraniState();
}

class _BorcOdemeEkraniState extends ConsumerState<BorcOdemeEkrani> {
  final _depo = BorcDeposu();
  final _tutarCtrl = TextEditingController();
  final _aciklamaCtrl = TextEditingController();
  String _odemeYontemi = 'Nakit';
  bool _yukleniyor = false;

  @override
  void initState() {
    super.initState();
    _tutarCtrl.text = widget.borc.kalanTutar.toStringAsFixed(2);
  }

  @override
  void dispose() {
    _tutarCtrl.dispose();
    _aciklamaCtrl.dispose();
    super.dispose();
  }

  Future<void> _odemeYap() async {
    final tutar = double.tryParse(_tutarCtrl.text.replaceAll(',', '.'));
    if (tutar == null || tutar <= 0) {
      BildirimServisi.uyari(context, 'Geçerli tutar girin');
      return;
    }
    if (tutar > widget.borc.kalanTutar) {
      BildirimServisi.uyari(context, 'Kalan borçtan fazla ödeme yapılamaz');
      return;
    }

    setState(() => _yukleniyor = true);
    try {
      final yeniOdenen = (widget.borc.odenenTutar + tutar).clamp(0, widget.borc.tutar);
      final odendi = yeniOdenen >= widget.borc.tutar - 0.01;
      final guncel = BorcModel(
        id: widget.borc.id,
        baslik: widget.borc.baslik,
        tur: widget.borc.tur,
        altTur: widget.borc.altTur,
        tutar: widget.borc.tutar,
        odenenTutar: yeniOdenen.toDouble(),
        kesimTarihi: widget.borc.kesimTarihi,
        sonOdemeTarihi: widget.borc.sonOdemeTarihi,
        odemeTarihi: odendi ? DateTime.now() : widget.borc.odemeTarihi,
        taksitSayisi: widget.borc.taksitSayisi,
        odenenTaksit: odendi ? widget.borc.taksitSayisi : widget.borc.odenenTaksit + 1,
        aciklama: _aciklamaCtrl.text.trim().isEmpty ? null : _aciklamaCtrl.text.trim(),
        dosyaNo: widget.borc.dosyaNo,
        referansNo: widget.borc.referansNo,
        odendi: odendi,
        hatirlatmaGonderildi: widget.borc.hatirlatmaGonderildi,
        oncelik: widget.borc.oncelik,
        notlar: widget.borc.notlar,
      );
      await _depo.guncelle(guncel);
      if (mounted) {
        BildirimServisi.basari(context, 'Ödeme kaydedildi');
        Navigator.pop(context, true);
      }
    } catch (e) {
      if (mounted) BildirimServisi.hata(context, 'Hata: $e');
    } finally {
      if (mounted) setState(() => _yukleniyor = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: context.scaffoldBg,
      appBar: AppBar(
        title: Text('Ödeme Yap - ${widget.borc.baslik}'),
      ),
      body: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(children: [
          // Bilgi kartı
          Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: Colors.blue.shade50,
              borderRadius: BorderRadius.circular(12),
              border: Border.all(color: Colors.blue.shade200),
            ),
            child: Column(children: [
              Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
                const Text('Toplam Borç', style: TextStyle(fontWeight: FontWeight.w600)),
                Text(ParaUtils.formatla(widget.borc.tutar),
                    style: const TextStyle(fontWeight: FontWeight.w800)),
              ]),
              const SizedBox(height: 4),
              Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
                const Text('Ödenen', style: TextStyle(fontWeight: FontWeight.w600)),
                Text(ParaUtils.formatla(widget.borc.odenenTutar),
                    style: const TextStyle(fontWeight: FontWeight.w600)),
              ]),
              const Divider(height: 16),
              Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
                const Text('Kalan', style: TextStyle(fontWeight: FontWeight.w700, fontSize: 15)),
                Text(ParaUtils.formatla(widget.borc.kalanTutar),
                    style: const TextStyle(fontWeight: FontWeight.w800, fontSize: 18, color: Colors.orange)),
              ]),
            ]),
          ),
          const SizedBox(height: 24),

          // Tutar
          TextField(
            controller: _tutarCtrl,
            keyboardType: const TextInputType.numberWithOptions(decimal: true),
            style: const TextStyle(fontSize: 24, fontWeight: FontWeight.bold),
            decoration: const InputDecoration(
              labelText: 'Ödeme Tutarı',
              prefixIcon: Icon(Icons.attach_money),
              border: OutlineInputBorder(),
            ),
          ),
          const SizedBox(height: 16),

          // Ödeme Yöntemi
          DropdownButtonFormField<String>(
            value: _odemeYontemi,
            decoration: const InputDecoration(
              labelText: 'Ödeme Yöntemi',
              prefixIcon: Icon(Icons.payment),
              border: OutlineInputBorder(),
            ),
            items: ['Nakit', 'Banka', 'Kredi Kartı', 'Havale']
                .map((v) => DropdownMenuItem(value: v, child: Text(v)))
                .toList(),
            onChanged: (v) => setState(() => _odemeYontemi = v!),
          ),
          const SizedBox(height: 16),

          // Açıklama
          TextField(
            controller: _aciklamaCtrl,
            maxLines: 2,
            decoration: const InputDecoration(
              labelText: 'Açıklama (Opsiyonel)',
              prefixIcon: Icon(Icons.note_add),
              border: OutlineInputBorder(),
            ),
          ),
          const SizedBox(height: 24),

          // Buton
          SizedBox(
            width: double.infinity,
            height: 52,
            child: FilledButton.icon(
              onPressed: _yukleniyor ? null : _odemeYap,
              icon: _yukleniyor
                  ? const SizedBox(width: 20, height: 20,
                      child: CircularProgressIndicator(strokeWidth: 2, color: Colors.white))
                  : const Icon(Icons.payments_outlined),
              label: Text(_yukleniyor ? 'İşleniyor...' : 'Ödeme Yap'),
            ),
          ),
        ]),
      ),
    );
  }
}