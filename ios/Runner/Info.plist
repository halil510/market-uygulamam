<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Halk Market</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>halk_market</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- 🔴🔴 KRİTİK DÜZELTME (komple derin analizde bulundu): bu dosyada
	     HİÇBİR NS*UsageDescription anahtarı yoktu. Uygulama kamera
	     (barkod okuma/mobile_scanner, ürün fotoğrafı/image_picker),
	     Bluetooth (termal yazıcı/flutter_blue_plus), mikrofon (sesli
	     arama/speech_to_text), Face ID/Touch ID (biyometrik giriş/
	     local_auth) ve fotoğraf kütüphanesi izinleri istiyor — iOS,
	     açıklama string'i olmayan bir izni ilk istediği anda uygulamayı
	     ANINDA ÇÖKERTİR (Android'in aksine sessizce reddetmez). Bu
	     anahtarlar olmadan uygulama iOS'ta barkod okutma/yazıcı bağlama/
	     biyometrik giriş/fotoğraf ekleme denendiği an kesin çöker. -->
	<key>NSCameraUsageDescription</key>
	<string>Ürün barkodunu okutmak ve ürün fotoğrafı çekmek için kameraya ihtiyaç duyulur.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sesli arama ve sesli komut özelliklerini kullanabilmek için mikrofona ihtiyaç duyulur.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Termal fiş yazıcısı ve barkod okuyucu gibi Bluetooth cihazlara bağlanmak için gereklidir.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Termal fiş yazıcısı ve barkod okuyucu gibi Bluetooth cihazlara bağlanmak için gereklidir.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Şifre yerine Face ID/Touch ID ile hızlı ve güvenli giriş yapabilmeniz için kullanılır.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ürün fotoğrafı veya fatura/irsaliye görseli seçebilmek için fotoğraf kütüphanesine erişim gerekir.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Oluşturulan fiş/rapor görsellerini fotoğraf kütüphanenize kaydedebilmek için gereklidir.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Aynı ağdaki yazıcı ve diğer cihazlarla (yerel senkronizasyon, ağ yazıcısı) iletişim kurmak için gereklidir.</string>
</dict>
</plist>
