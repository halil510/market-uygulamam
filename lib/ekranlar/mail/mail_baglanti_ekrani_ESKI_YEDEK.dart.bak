// lib/ekranlar/mail/mail_baglanti_ekrani.dart
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import '../../saglayicilar/riverpod/mail_provider.dart';
import '../../servisler/bildirim_servisi.dart';
import '../../uygulama/tema/uygulama_temasi.dart';

class MailBaglantiEkrani extends ConsumerStatefulWidget {
  const MailBaglantiEkrani({super.key});

  @override
  ConsumerState<MailBaglantiEkrani> createState() => _MailBaglantiEkraniState();
}

class _MailBaglantiEkraniState extends ConsumerState<MailBaglantiEkrani> {
  final _emailCtrl = TextEditingController();
  final _sifreCtrl = TextEditingController();
  bool _sifreGoster = false;
  bool _baglaniyor = false;
  bool _bagli = false; // demo için

  @override
  void dispose() {
    _emailCtrl.dispose();
    _sifreCtrl.dispose();
    super.dispose();
  }

  Future<void> _baglan() async {
    if (_emailCtrl.text.trim().isEmpty || _sifreCtrl.text.trim().isEmpty) {
      BildirimServisi.uyari(context, 'E-posta ve şifre girin');
      return;
    }

    setState(() => _baglaniyor = true);
    try {
      // Gerçek servis çağrısı simülasyonu
      await Future.delayed(const Duration(seconds: 2));
      
      // Demo: her zaman başarılı
      _bagli = true;
      
      // ref.invalidate(mailBaglantiProvider);
      // ref.invalidate(mailListesiProvider);
      
      if (!mounted) return;
      BildirimServisi.basari(context, 'Mail hesabına bağlanıldı (demo)');
      Navigator.pop(context);
    } catch (e) {
      if (mounted) BildirimServisi.hata(context, 'Bağlantı hatası: $e');
    } finally {
      if (mounted) setState(() => _baglaniyor = false);
    }
  }

  void _yardimGoster() {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
        title: const Row(children: [
          Icon(Icons.help_outline, color: AppRenkler.primary),
          SizedBox(width: 8),
          Text('Nasıl Bağlanır?'),
        ]),
        content: SingleChildScrollView(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            mainAxisSize: MainAxisSize.min,
            children: [
              _yardimBaslik('Gmail'),
              _yardimMetin('Google Hesabı > Güvenlik > "Uygulama Şifreleri" bölümünden 16 haneli bir şifre oluşturun.'),
              _yardimMetin('Bu şifreyi "Uygulama Şifresi" alanına yapıştırın.'),
              const SizedBox(height: 12),
              _yardimBaslik('Outlook / Microsoft'),
              _yardimMetin('Hesap ayarlarından "İki Aşamalı Doğrulama" aktif ise "Uygulama Şifresi" oluşturun.'),
              _yardimMetin('Değilse normal şifrenizi kullanabilirsiniz.'),
              const SizedBox(height: 12),
              _yardimBaslik('Güvenlik Uyarısı'),
              _yardimMetin('Şifreniz cihazda şifrelenmiş olarak saklanır. Hiçbir yere gönderilmez.'),
            ],
          ),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Kapat')),
        ],
      ),
    );
  }

  Widget _yardimBaslik(String t) => Padding(
    padding: const EdgeInsets.only(top: 8, bottom: 4),
    child: Text(t, style: const TextStyle(fontWeight: FontWeight.w700, fontSize: 14)),
  );
  Widget _yardimMetin(String t) => Padding(
    padding: const EdgeInsets.only(bottom: 6),
    child: Text(t, style: const TextStyle(fontSize: 13, color: Colors.grey)),
  );

  @override
  Widget build(BuildContext context) {
    final saglayici = ref.watch(mailSaglayiciProvider);

    return Scaffold(
      backgroundColor: context.scaffoldBg,
      appBar: AppBar(
        elevation: 0,
        flexibleSpace: Container(
          decoration: const BoxDecoration(
            gradient: LinearGradient(
              colors: [Color(0xFF1A237E), Color(0xFF4361EE)],
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
            ),
          ),
        ),
        foregroundColor: Colors.white,
        iconTheme: const IconThemeData(color: Colors.white),
        actionsIconTheme: const IconThemeData(color: Colors.white),
        title: const Text('Mail Bağlantısı'),
        actions: [
          IconButton(
            icon: const Icon(Icons.help_outline, color: Colors.white),
            onPressed: _yardimGoster,
          ),
        ],
      ),
      body: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          children: [
            // Bağlantı durumu kartı (demo)
            Container(
              padding: const EdgeInsets.all(14),
              decoration: BoxDecoration(
                color: _bagli ? Colors.green.shade50 : Colors.orange.shade50,
                borderRadius: BorderRadius.circular(12),
                border: Border.all(
                  color: _bagli ? Colors.green.shade200 : Colors.orange.shade200,
                ),
              ),
              child: Row(children: [
                Icon(
                  _bagli ? Icons.check_circle : Icons.info_outline,
                  color: _bagli ? Colors.green : Colors.orange,
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: Text(
                    _bagli
                        ? 'Bağlantı aktif. E-postalar otomatik taranacak.'
                        : 'Henüz bağlanmadı. E-posta ve şifre ile bağlantı kurun.',
                    style: TextStyle(
                      fontSize: 13,
                      color: _bagli ? Colors.green.shade700 : Colors.orange.shade700,
                    ),
                  ),
                ),
              ]),
            ),
            const SizedBox(height: 20),

            // Sağlayıcı seçimi
            Container(
              padding: const EdgeInsets.all(14),
              decoration: BoxDecoration(
                color: context.cardBg,
                borderRadius: BorderRadius.circular(14),
                border: Border.all(color: context.borderColor),
              ),
              child: Row(children: [
                const Icon(Icons.email_outlined, color: AppRenkler.primary),
                const SizedBox(width: 12),
                const Text('Sağlayıcı:', style: TextStyle(fontWeight: FontWeight.w600)),
                const SizedBox(width: 12),
                SegmentedButton<MailSaglayici>(
                  segments: const [
                    ButtonSegment(
                      value: MailSaglayici.gmail,
                      label: Text('Gmail'),
                      icon: Icon(Icons.mail_outline, size: 16),
                    ),
                    ButtonSegment(
                      value: MailSaglayici.outlook,
                      label: Text('Outlook'),
                      icon: Icon(Icons.business_center_outlined, size: 16),
                    ),
                  ],
                  selected: {saglayici},
                  onSelectionChanged: (s) {
                    ref.read(mailSaglayiciProvider.notifier).state = s.first;
                    setState(() => _bagli = false); // demo
                  },
                  style: SegmentedButton.styleFrom(
                    selectedBackgroundColor: AppRenkler.primary.withOpacity(0.1),
                    selectedForegroundColor: AppRenkler.primary,
                  ),
                ),
              ]),
            ),
            const SizedBox(height: 24),

            // E-posta
            TextField(
              controller: _emailCtrl,
              keyboardType: TextInputType.emailAddress,
              decoration: const InputDecoration(
                labelText: 'E-posta Adresi',
                hintText: 'ornek@mail.com',
                prefixIcon: Icon(Icons.email),
                border: OutlineInputBorder(),
                filled: true,
                fillColor: Colors.white,
              ),
            ),
            const SizedBox(height: 16),

            // Şifre
            TextField(
              controller: _sifreCtrl,
              obscureText: !_sifreGoster,
              decoration: InputDecoration(
                labelText: saglayici == MailSaglayici.gmail
                    ? 'Uygulama Şifresi'
                    : 'Şifre / Uygulama Şifresi',
                hintText: saglayici == MailSaglayici.gmail
                    ? '16 haneli uygulama şifresi'
                    : 'Hesap şifreniz veya uygulama şifresi',
                prefixIcon: const Icon(Icons.lock),
                suffixIcon: IconButton(
                  icon: Icon(_sifreGoster ? Icons.visibility_off : Icons.visibility),
                  onPressed: () => setState(() => _sifreGoster = !_sifreGoster),
                ),
                border: const OutlineInputBorder(),
                filled: true,
                fillColor: Colors.white,
                helperText: saglayici == MailSaglayici.gmail
                    ? 'Gmail için "Uygulama Şifresi" oluşturmayı unutmayın.'
                    : null,
                helperStyle: const TextStyle(fontSize: 11),
              ),
            ),
            const SizedBox(height: 8),

            // Bilgi
            if (saglayici == MailSaglayici.gmail)
              Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: Colors.blue.shade50,
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(color: Colors.blue.shade200),
                ),
                child: Row(children: [
                  const Icon(Icons.info_outline, color: Colors.blue, size: 16),
                  const SizedBox(width: 8),
                  Expanded(
                    child: Text(
                      'Gmail için "Uygulama Şifresi" kullanın. '
                      'Google Hesabı > Güvenlik > Uygulama Şifreleri',
                      style: TextStyle(fontSize: 12, color: Colors.blue.shade700),
                    ),
                  ),
                ]),
              ),

            const Spacer(),

            // Bağlan butonu
            SizedBox(
              width: double.infinity,
              height: 54,
              child: FilledButton.icon(
                onPressed: _baglaniyor ? null : _baglan,
                icon: _baglaniyor
                    ? const SizedBox(
                        width: 20,
                        height: 20,
                        child: CircularProgressIndicator(
                          strokeWidth: 2,
                          color: Colors.white,
                        ),
                      )
                    : const Icon(Icons.link),
                label: Text(
                  _baglaniyor ? 'Bağlanıyor...' : 'Mail Hesabını Bağla',
                  style: const TextStyle(fontSize: 15, fontWeight: FontWeight.w700),
                ),
                style: FilledButton.styleFrom(
                  foregroundColor: Colors.white,
                  backgroundColor: AppRenkler.primary,
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(14),
                  ),
                ),
              ),
            ),
            const SizedBox(height: 8),
            Text(
              'Bağlantı bilgileri cihazda şifrelenir.',
              style: TextStyle(fontSize: 11, color: context.textHint),
            ),
            const SizedBox(height: 12),
          ],
        ),
      ),
    );
  }
}