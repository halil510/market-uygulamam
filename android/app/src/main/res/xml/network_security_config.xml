<?xml version="1.0" encoding="utf-8"?>
<!--
    ÖNEMLİ: Bu dosya AndroidManifest.xml'de referans veriliyordu ama
    projede HİÇ YOKTU — bu, Play Store için release derlemesi
    alınırken derleme hatasına (eksik kaynak) yol açabilirdi.

    Bu yapılandırma, şifrelenmemiş (HTTP) trafiğe İZİN VERİYOR çünkü
    uygulama yerel ağdaki cihazlarla (WiFi termal yazıcılar — port 9100,
    genelde düz TCP kullanır; yerel WiFi senkronizasyonu — kendi HTTP
    sunucumuz) konuşuyor. Supabase/GİB/TCMB gibi İNTERNET üzerinden
    yapılan TÜM bağlantılar zaten HTTPS kullanıyor — bu ayardan
    etkilenmiyorlar (onlar için Android'in varsayılan, HTTPS-zorunlu
    davranışı geçerli).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
